{
  "name": "homebridge-unifi-access",
  "version": "1.12.1",
  "displayName": "UniFi Access",
  "description": "Homebridge UniFi Access plugin providing complete HomeKit integration for the UniFi Access ecosystem with full support for most features including autoconfiguration, multiple controllers, and realtime updates.",
  "author": {
    "name": "HJD",
    "url": "https://github.com/hjdhjd"
  },
  "homepage": "https://github.com/hjdhjd/homebridge-unifi-access#readme",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git://github.com/hjdhjd/homebridge-unifi-access.git"
  },
  "bugs": {
    "url": "http://github.com/hjdhjd/homebridge-unifi-access/issues"
  },
  "type": "module",
  "engines": {
    "homebridge": ">=2.0.0",
    "node": ">=22.20"
  },
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homebridge-unifi-access",
    "homekit",
    "camera",
    "doorbell",
    "ubiquiti",
    "unifi",
    "unifi access",
    "unifi protect",
    "security",
    "udm",
    "udm pro",
    "udm-pro",
    "unifi camera",
    "unifi cloud key",
    "unifi dream machine pro",
    "unifios"
  ],
  "scripts": {
    "prebuild": "npm run clean && npm run build-ui",
    "build": "tsc -p tsconfig.build.json",
    "build-ui": "homebridge-plugin-utils prepare-ui homebridge-ui/public/lib",
    "build-docs": "npm run build && homebridge-plugin-utils prepare-docs dist/access-options.js && homebridge-plugin-utils prepare-chrome docChrome.json",
    "clean": "shx rm -rf dist homebridge-ui/public/lib",
    "prelint": "npm run build-ui",
    "lint": "eslint --max-warnings=${ESLINT_MAX_WARNINGS:-\"0\"} eslint.config.mjs src homebridge-ui/*.js homebridge-ui/public/**.mjs",
    "postpublish": "npm run clean",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "node --test --experimental-test-coverage --test-timeout=15000 \"src/**/*.test.ts\"",
    "test:watch": "node --test --watch \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "main": "dist/index.js",
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.5",
    "homebridge-plugin-utils": "file:../homebridge-plugin-utils",
    "unifi-access": "file:../unifi-access"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.2.0",
    "eslint": "9.39.2",
    "homebridge": "2.4.0",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "overrides": {
    "@types/readable-stream": "4.0.23"
  }
}

/* Copyright(C) 2017-2026, HJD (https://github.com/hjdhjd). All rights reserved.
 *
 * tsconfig.json: Project declaration discovered by IDEs and typescript-eslint's project service, and the type-check pass (`npm run typecheck`). It type-checks
 * everything under src, the webUI's TypeScript modules and the full colocated test suite included. `noEmit` keeps `tsc -p tsconfig.json` from producing build
 * output - emitting the published `dist/` is exclusively tsconfig.build.json's job, which narrows to `src` and excludes the test/fixtures/helpers files so they never
 * reach the package. The webUI's JavaScript and eslint.config.mjs are not inputs here: typescript-eslint lints them through its default project, which takes the
 * files eslint.config.mjs's allowDefaultProject list names. Both projects extend homebridge-plugin-utils' plugin profile, which turns declaration emit off over the
 * family's shared base: a plugin publishes no types.
 */
{
  "compilerOptions": {

    "noEmit": true
  },

  "exclude": [ "dist", "node_modules" ],
  "extends": "./node_modules/homebridge-plugin-utils/build/tsconfig.plugin.json",
  "include": ["src"]
}
